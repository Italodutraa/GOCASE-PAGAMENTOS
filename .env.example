# Copie para .env.local e preencha. NUNCA versione o token real.
# Chave do AI Proxy do evento. Vazia = modo replay (roda sem chamadas ao proxy).
AI_PROXY_API_KEY=
# Base do AI Proxy do evento.
AI_PROXY_BASE_URL=https://ai-proxy.gogroupbr.com/v1
# Modelo do agente explicador (chat): latest | glm-5.3-flash
AI_CHAT_MODEL=latest
# Modelo dos especialistas com ferramentas (padrão do projeto).
AI_AGENT_MODEL=glm-5.3-flash
